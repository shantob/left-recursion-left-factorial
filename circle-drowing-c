#include <GL/glut.h>
#include <stdio.h>

int h, k, r;

void myInit()
{
    glClearColor(1.0, 0.0, 0.0, 1.0);
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
    glColor3f(0.0, 1.0, 0.0);
    glPointSize(4.0);
    glMatrixMode(GL_PROJECTION);
    gluOrtho2D(-10000, 10000, -10000, 10000);
}

void draw_pixel(int x, int y)
{
    glBegin(GL_POINTS);
    glVertex2i(x + h, y + k);
    glVertex2i(-x + h, y + k);
    glVertex2i(x + h, -y + k);
    glVertex2i(-x + h, -y + k);
    glVertex2i(y + h, x + k);
    glVertex2i(-y + h, x + k);
    glVertex2i(y + h, -x + k);
    glVertex2i(-y + h, -x + k);
    glEnd();
}

void circle(int r)
{
    int x, y, d, i;
    x = 0;
    y = r;
    d = 3 - 2 * r;
    draw_pixel(x, y);
    while (x <= y) {
        if (d < 0) {
            d = d + 4 * x + 6;
            x = x + 1;
        } else {
            d = d + 4 * (x - y) + 10;
            x = x + 1;
            y = y - 1;
        }
        draw_pixel(x, y);
    }
}

void myDisplay()
{
    circle(r);
    glFlush();
}

int main(int argc, char **argv)
{
    printf("Value for center:");
    scanf("%d %d", &h, &k);
    printf("Enter radius:");
    scanf("%d", &r);

    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(700, 700);
    glutInitWindowPosition(50, 50);
    glutCreateWindow("Bresenham's line Drawing");
    myInit();
    glutDisplayFunc(myDisplay);

    glutMainLoop();
    return 0;
}
